{
	"name": "my-van-damme",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build/index.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --import ./scripts/register-aliases.mjs scripts/migrate.ts",
		"db:seed": "node --import ./scripts/register-aliases.mjs scripts/seed.ts",
		"db:studio": "drizzle-kit studio",
		"db:reset": "node scripts/reset.ts",
		"skill:write": "node --import ./scripts/register-aliases.mjs scripts/write-skill.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"drizzle-kit": "^0.31.10",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.2.2"
	},
	"dependencies": {
		"better-auth": "^1.7.4",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.2",
		"zod": "^4.6.1"
	},
	"allowScripts": {
		"better-sqlite3@13.0.3": true,
		"esbuild@0.18.20": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.2": true
	},
	"overrides": {
		"better-sqlite3": "$better-sqlite3"
	}
}
