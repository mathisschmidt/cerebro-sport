# Variables the stack needs.
#
# Plain compose: copy this to .env next to docker-compose.yml.
# Portainer:     set them in the stack's Environment section instead — Portainer
#                does not read this file.

# --- required ---------------------------------------------------------------

# Signs session cookies. Generate one with:
#   openssl rand -base64 32
# The app refuses to serve in production without it. Changing it later signs
# everyone out.
BETTER_AUTH_SECRET=

# The public URL, scheme included, no trailing slash. SvelteKit and Better Auth
# build absolute URLs from this and cannot infer it behind a proxy.
# On a LAN with no domain, use the address you actually type on the phone:
#   ORIGIN=http://192.168.1.20:3000
ORIGIN=https://training.example.com

# --- first boot only --------------------------------------------------------

# The admin account created the first time the app starts. Ignored afterwards.
# Change the password on first sign-in regardless.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-first-boot

# --- optional ---------------------------------------------------------------

# Where the container is published on the host. The default listens on every
# interface, port 3000. Set BIND_ADDRESS=127.0.0.1 if a reverse proxy on this
# host should be the only thing that can reach it.
# BIND_ADDRESS=0.0.0.0
# HOST_PORT=3000

# Defaults to ORIGIN; set only if the auth origin differs from the app's.
# BETTER_AUTH_URL=
